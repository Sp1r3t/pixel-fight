local Choreography = {}
-- Finish at ground height so the cinematic and the resumed simulation meet.
for _, path in paths do
	path[#path][3] = 0
	path[#path][5] = 0
end
function Choreography.sample(id: string, progress: number): (number, number, number, number)
	local path = paths[id] or paths.rook
	for i = 2, #path do
		local a, b = path[i - 1], path[i]
		if progress <= b[1] then
			local t = math.clamp((progress - a[1]) / (b[1] - a[1]), 0, 1)
			t = t * t * (3 - 2 * t)
			return a[2] + (b[2] - a[2]) * t,
				a[3] + (b[3] - a[3]) * t,
				a[4] + (b[4] - a[4]) * t,
				a[5] + (b[5] - a[5]) * t
		end
	end
	local b = path[#path]
	return b[2], b[3], b[4], b[5]
end
function Choreography.offsets(
	id: string,
	victimRole: string?,
	attackerX: number,
	defenderX: number,
	progress: number,
	wall: number?
): (number, number, number, number)
	local dir = if defenderX >= attackerX then 1 else -1
	local advance, height, push, lift = Choreography.sample(id, progress)
	local approach = math.clamp((defenderX - attackerX) * dir - 2.2, 0, 12)
	local attackerOffset = dir * approach * advance
	local defenderOffset = dir * push
	if id == "brakk" or id == "morrow" or id == "tidebreaker" then
		local clearance = if victimRole == "tank" then 2.8 elseif victimRole == "agile" then 1.8 else 2.2
		local gripX = attackerX + attackerOffset + dir * clearance
		local pullProgress = math.clamp((progress - 0.15) / 0.2, 0, 1)
		pullProgress = pullProgress * pullProgress * (3 - 2 * pullProgress)
		local release = math.clamp((progress - 0.76) / 0.24, 0, 1)
		defenderOffset = (gripX - defenderX) * pullProgress + dir * release * 3
	end
	if wall then
		attackerOffset = math.clamp(attackerX + attackerOffset, -wall, wall) - attackerX
		defenderOffset = math.clamp(defenderX + defenderOffset, -wall, wall) - defenderX
	end
	return attackerOffset, height, defenderOffset, lift
end
return Choreography
